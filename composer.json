{
  "name": "nameera/ui-template",
  "description": "A Laravel package providing Nameera UI starter kit with Tailwind CSS and Alpine.js",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Nameera\\Ui\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Nameera\\Ui\\NameeraUiServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0|^11.0"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
